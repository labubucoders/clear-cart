{
  "manifest_version": 3,
  "name": "ClearCart — Dark Pattern Detector & Site Grader",
  "version": "1.0.0",
  "description": "ClearCart detects psychological manipulation, fake urgency, countdowns, and confirmshaming, grading e-commerce sites from A to F.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ClearCart"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "scripts/rules.js",
        "scripts/highlighter.js",
        "scripts/detector.js",
        "scripts/content.js"
      ],
      "css": ["scripts/highlighter.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "test-store/*",
        "scripts/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
